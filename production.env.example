# Copy these keys into your hosting provider's secret/environment settings.
# Never put real passwords or OAuth secrets in this file or commit them.
SPRING_PROFILES_ACTIVE=prod
PORT=8080

# Cloud SQL Java Connector URL. Replace the database, project, region, and
# instance placeholders. The connector handles the encrypted connection to SQL.
DB_URL=jdbc:postgresql:///jobtracker?socketFactory=com.google.cloud.sql.postgres.SocketFactory&cloudSqlInstance=PROJECT_ID:europe-west1:INSTANCE_ID&sslmode=disable
DB_USERNAME=jobtracker_app
DB_PASSWORD=
# The Cloud SQL Java Connector provides TLS; pgJDBC SSL is disabled inside its
# connector tunnel as required by Google's JDBC connector examples.
DB_SSL_MODE=disable
DB_POOL_SIZE=5

# Dedicated Flyway role; can temporarily match the app role, but separate roles
# reduce the impact of a compromised application credential.
MIGRATION_DB_URL=jdbc:postgresql:///jobtracker?socketFactory=com.google.cloud.sql.postgres.SocketFactory&cloudSqlInstance=PROJECT_ID:europe-west1:INSTANCE_ID&sslmode=disable
MIGRATION_DB_USERNAME=jobtracker_migrator
MIGRATION_DB_PASSWORD=

# Leave a provider disabled by leaving both values unset. Configure matching
# HTTPS callbacks in each OAuth provider console after your domain is chosen.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
